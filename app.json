{
  "expo": {
    "name": "DiceFrame",
    "slug": "diceframe",
    "version": "0.5.2",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "diceframe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "语音输入需要使用麦克风录制你的行动描述。"
      },
      "bundleIdentifier": "com.diceframe.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#120f0c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.diceframe.mobile",
      "versionCode": 10,
      "permissions": [
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#120f0c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择图片作为你的角色头像。"
        }
      ],
      "./plugins/withCleartextTraffic",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAbiSplits",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
